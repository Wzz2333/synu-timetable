<!--pages/import/preview/index.wxml-->
<view class="bg-layer" wx:if="{{bgImage}}">
  <image class="bg-image" src="{{bgImage}}" mode="aspectFill" style="opacity: {{bgOpacity}};" />
</view>
<view class="preview-page">
  <!-- 顶部摘要 -->
  <view class="summary-card">
    <view class="summary-row">
      <text class="summary-label">目标课表</text>
      <text class="summary-value">{{timetableName}}</text>
    </view>
    <view class="summary-row">
      <text class="summary-label">待导入课程</text>
      <text class="summary-value primary">{{courses.length}} 门</text>
    </view>
    <view class="summary-tip" wx:if="{{stats.merged > 0}}">
      已自动合并 {{stats.merged}} 条同名课程（同一教师多时段 / 调课）
    </view>
  </view>

  <!-- 警告提示 -->
  <view class="warnings-card" wx:if="{{warnings.length > 0}}">
    <view class="warnings-title">解析提示</view>
    <view class="warning-item" wx:for="{{warnings}}" wx:key="*this">{{item}}</view>
  </view>

  <!-- 课程列表 -->
  <view class="course-list">
    <view
      class="course-card"
      wx:for="{{displayCourses}}"
      wx:key="index"
      wx:for-index="idx"
      data-idx="{{idx}}"
      bindtap="toggleEdit"
    >
      <view class="course-head">
        <view class="course-name">{{item.name}}</view>
        <view class="course-weektype weektype-{{item.weekType}}">{{weekTypeLabel[item.weekType]}}</view>
      </view>
      <view class="course-meta">
        <text class="meta-item">🕐 {{slotTextList[idx]}}</text>
      </view>
      <view class="course-meta">
        <text class="meta-item">📍 {{item.room || '未指定'}}</text>
        <text class="meta-item">👤 {{item.teacher || '未指定'}}</text>
      </view>
      <view class="course-meta" wx:if="{{item.remark}}">
        <text class="meta-item remark">📝 {{item.remark}}</text>
      </view>
      <view class="course-weeks">
        <text class="weeks-text">第{{item.startWeek}}-{{item.endWeek}}周（共{{item.weeks.length}}周）</text>
        <text class="edit-btn" catchtap="editCourse" data-idx="{{idx}}">编辑 ✎</text>
      </view>

      <!-- 行内编辑面板（展开式） -->
      <view class="edit-panel" wx:if="{{editingIdx === idx}}" catchtap="">
        <view class="edit-row">
          <text class="edit-label">课程名</text>
          <input class="edit-input" value="{{item.name}}" data-idx="{{idx}}" data-field="name" bindinput="onCourseInput" />
        </view>
        <view class="edit-row">
          <text class="edit-label">教师</text>
          <input class="edit-input" value="{{item.teacher}}" data-idx="{{idx}}" data-field="teacher" bindinput="onCourseInput" />
        </view>
        <view class="edit-row">
          <text class="edit-label">教室</text>
          <input class="edit-input" value="{{item.room}}" data-idx="{{idx}}" data-field="room" bindinput="onCourseInput" />
        </view>
        <view class="edit-row">
          <text class="edit-label">起始周</text>
          <input class="edit-input small" type="number" value="{{item.startWeek}}" data-idx="{{idx}}" data-field="startWeek" bindinput="onCourseInput" />
          <text class="edit-label" style="margin-left:24rpx;">结束周</text>
          <input class="edit-input small" type="number" value="{{item.endWeek}}" data-idx="{{idx}}" data-field="endWeek" bindinput="onCourseInput" />
        </view>
        <view class="edit-actions">
          <view class="edit-btn-secondary" catchtap="toggleEdit" data-idx="{{idx}}">完成</view>
          <view class="edit-btn-danger" catchtap="removeCourse" data-idx="{{idx}}">删除此课程</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-tip" wx:if="{{courses.length === 0}}">
    <text>所有课程都被移除了</text>
  </view>

  <!-- 底部固定操作区 -->
  <view class="footer-bar">
    <view class="footer-info">将导入 <text class="footer-count">{{courses.length}}</text> 门课程</view>
    <button class="footer-btn cancel" bindtap="goBack">返回修改</button>
    <button class="footer-btn confirm" bindtap="doImport" disabled="{{courses.length === 0 || importing}}">
      {{importing ? '导入中' : '确认导入'}}
    </button>
  </view>
</view>
