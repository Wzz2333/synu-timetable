/* pages/import/preview/index.wxss */

.bg-layer {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 0;
  pointer-events: none;
}

.bg-image {
  width: 100%;
  height: 100%;
}

.preview-page {
  min-height: 100vh;
  padding: 30rpx 30rpx 200rpx;
  position: relative;
  z-index: 1;
}

/* 摘要卡 */
.summary-card {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  border-left: 6rpx solid #1989fa;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 6rpx 0;
  font-size: 28rpx;
}

.summary-label {
  color: #666;
}

.summary-value {
  color: #333;
  font-weight: 500;
}

.summary-value.primary {
  color: #1989fa;
  font-weight: 600;
}

.summary-tip {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #888;
  line-height: 1.5;
}

/* 警告卡 */
.warnings-card {
  background: rgba(255, 243, 205, 0.95);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  border-left: 6rpx solid #e67e22;
}

.warnings-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #b06d12;
  margin-bottom: 8rpx;
}

.warning-item {
  font-size: 24rpx;
  color: #8a5a0a;
  line-height: 1.6;
}

/* 课程卡 */
.course-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.course-card {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 14rpx;
  padding: 22rpx 26rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.course-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.course-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
  margin-right: 12rpx;
}

.course-weektype {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  background: #f0f0f0;
  color: #666;
  flex-shrink: 0;
}

.course-weektype.weektype-all { background: #e3f2fd; color: #1976d2; }
.course-weektype.weektype-odd { background: #fff3e0; color: #e65100; }
.course-weektype.weektype-even { background: #f3e5f5; color: #6a1b9a; }
.course-weektype.weektype-custom { background: #ffebee; color: #c62828; }

.course-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 24rpx;
  margin-top: 6rpx;
  font-size: 26rpx;
  color: #555;
}

.meta-item.remark {
  color: #e67e22;
  font-size: 24rpx;
  width: 100%;
}

.course-weeks {
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 2rpx dashed #eee;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.weeks-text {
  font-size: 24rpx;
  color: #888;
}

.edit-btn {
  font-size: 24rpx;
  color: #1989fa;
  padding: 4rpx 12rpx;
  border: 2rpx solid #1989fa;
  border-radius: 6rpx;
}

/* 行内编辑面板 */
.edit-panel {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #f0f0f0;
}

.edit-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.edit-label {
  font-size: 26rpx;
  color: #666;
  width: 110rpx;
  flex-shrink: 0;
}

.edit-input {
  flex: 1;
  background: #f7f7f7;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
  font-size: 26rpx;
  color: #333;
}

.edit-input.small {
  flex: 0 0 120rpx;
  margin-right: 0;
}

.edit-actions {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 2rpx dashed #eee;
}

.edit-btn-secondary {
  font-size: 26rpx;
  color: #1989fa;
  padding: 10rpx 30rpx;
  border: 2rpx solid #1989fa;
  border-radius: 8rpx;
}

.edit-btn-danger {
  font-size: 26rpx;
  color: #e74c3c;
  padding: 10rpx 30rpx;
  border: 2rpx solid #e74c3c;
  border-radius: 8rpx;
}

/* 空 */
.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 底部固定条 */
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.98);
  border-top: 2rpx solid #eee;
  padding: 20rpx 30rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  z-index: 10;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.footer-info {
  font-size: 26rpx;
  color: #666;
  flex: 1;
}

.footer-count {
  color: #1989fa;
  font-weight: 600;
  font-size: 30rpx;
  margin: 0 4rpx;
}

.footer-btn {
  border-radius: 10rpx;
  font-size: 28rpx;
  padding: 16rpx 30rpx;
  border: none;
  line-height: 1.4;
}

.footer-btn.cancel {
  background: #f5f5f5;
  color: #666;
}

.footer-btn.confirm {
  background: #1989fa;
  color: #fff;
}

.footer-btn.confirm[disabled] {
  background: #ccc;
  color: #fff;
}
