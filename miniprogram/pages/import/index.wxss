/* pages/import/index.wxss */

.bg-layer {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 0;
  pointer-events: none;
}

.bg-image {
  width: 100%;
  height: 100%;
}

.import-page {
  padding: 30rpx;
  min-height: 100vh;
  position: relative;
  z-index: 1;
  padding-bottom: 80rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 30rpx;
  color: #333;
}

/* 说明卡 */
.tip-card {
  background: rgba(255, 255, 255, 0.85);
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  border-left: 6rpx solid #1989fa;
}

.tip-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1989fa;
  margin-bottom: 12rpx;
}

.tip-step {
  font-size: 26rpx;
  color: #555;
  line-height: 1.8;
}

.highlight {
  color: #e67e22;
  font-weight: 500;
  background: rgba(230, 126, 34, 0.08);
  padding: 0 6rpx;
  border-radius: 4rpx;
}

.tip-warn {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #999;
  font-style: italic;
}

/* 表单卡 */
.form-card {
  background: rgba(255, 255, 255, 0.85);
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}

.form-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 14rpx;
}

.clear-btn {
  font-size: 24rpx;
  color: #1989fa;
  padding: 4rpx 12rpx;
}

.picker-val {
  background: #f5f5f5;
  border-radius: 10rpx;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
  color: #333;
}

.picker-empty {
  color: #999;
}

.paste-area {
  width: 100%;
  min-height: 360rpx;
  background: #f5f5f5;
  border-radius: 10rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #333;
  box-sizing: border-box;
}

.text-counter {
  text-align: right;
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 解析结果卡 */
.result-card {
  background: rgba(255, 255, 255, 0.85);
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  border-left: 6rpx solid #5CB85C;
}

.result-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
  font-size: 26rpx;
}

.result-label {
  color: #666;
}

.result-value {
  color: #1989fa;
  font-weight: 600;
}

.warnings {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed #eee;
}

.warning-title {
  font-size: 24rpx;
  color: #e67e22;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.warning-item {
  font-size: 24rpx;
  color: #888;
  line-height: 1.6;
  margin-bottom: 4rpx;
}

/* 主按钮 */
.action-btn {
  width: 100%;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  padding: 24rpx 0;
}

.action-btn.primary {
  background: #1989fa;
  color: #fff;
}

.action-btn[disabled] {
  background: #ccc;
  color: #fff;
}

.action-tip {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}

/* “+ 新建课表” 链接样式 */
.link-btn {
  font-size: 24rpx;
  color: #1989fa;
  padding: 4rpx 12rpx;
}

/* 新建课表弹窗（与 manage 页保持一致） */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 100;
}

.modal-popup {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255,255,255,0.97);
  border-radius: 24rpx 24rpx 0 0;
  z-index: 101;
  padding: 40rpx;
  max-height: 80vh;
  overflow-y: auto;
  transform: translateY(100%);
  transition: transform 0.3s;
}

.modal-popup.show {
  transform: translateY(0);
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.modal-hint {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 24rpx;
  line-height: 1.5;
}

.form-group {
  margin-bottom: 24rpx;
}

.modal-input {
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.modal-btn {
  flex: 1;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  text-align: center;
  border: none;
}

.modal-btn.cancel {
  background: #f5f5f5;
  color: #666;
}

.modal-btn.confirm {
  background: #1989fa;
  color: #fff;
}

.modal-btn[disabled] {
  background: #ccc;
  color: #fff;
}
