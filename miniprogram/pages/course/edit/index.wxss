/* pages/course/edit/index.wxss */

.bg-layer {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 0;
  pointer-events: none;
}

.bg-image {
  width: 100%;
  height: 100%;
}

.edit-page {
  padding: 30rpx;
  padding-bottom: 120rpx;
  position: relative;
  z-index: 1;
  min-height: 100vh;
}

.form-title {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 40rpx;
  color: #333;
}

.form-group {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.required {
  color: #e74c3c;
}

.form-input {
  background: rgba(248,248,248,0.7);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  border: 2rpx solid transparent;
}

.form-input:focus {
  border-color: #1989fa;
  background: #fff;
}

.form-row {
  display: flex;
  gap: 8rpx;
}

.form-half {
  flex: 1;
}

.form-third {
  flex: 1;
}

/* 时间段列表 */
.slot-item {
  background: rgba(250,250,250,0.5);
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #eee;
}

.slot-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.slot-title {
  font-size: 24rpx;
  color: #888;
}

.slot-remove {
  font-size: 24rpx;
  color: #e74c3c;
  padding: 4rpx 12rpx;
}

.add-slot-btn {
  font-size: 26rpx;
  color: #1989fa;
  padding: 16rpx 0;
  text-align: center;
  border: 2rpx dashed #1989fa;
  border-radius: 12rpx;
}

.mini-label {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 6rpx;
}

.picker-val {
  background: rgba(248,248,248,0.7);
  border-radius: 12rpx;
  padding: 18rpx 10rpx;
  font-size: 24rpx;
  color: #333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.week-input {
  text-align: center;
}

.submit-btn {
  margin-top: 50rpx;
  background: #1989fa;
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
}

/* 详细设置按钮 */
.detail-btn::after { border: none; }
.detail-btn {
  width: 100%;
  background: rgba(25,137,250,0.08);
  border: none;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #1989fa;
  padding: 18rpx 24rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

/* 周次弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 200;
}

.modal-popup {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 201;
  padding: 40rpx;
  max-height: 70vh;
  overflow-y: auto;
  transform: translateY(100%);
  transition: transform 0.3s;
}

.modal-popup.show {
  transform: translateY(0);
}

.modal-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.week-presets {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.preset-btn {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 24rpx;
  color: #1989fa;
  background: rgba(25,137,250,0.08);
  border-radius: 10rpx;
}

.week-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 30rpx;
}

.week-chip {
  width: calc(25% - 12rpx);
  text-align: center;
  padding: 16rpx 0;
  font-size: 24rpx;
  border-radius: 10rpx;
  background: #f5f5f5;
  color: #666;
}

.week-chip.on {
  background: #1989fa;
  color: #fff;
}

.modal-actions {
  display: flex;
}

.modal-btn {
  flex: 1;
  background: #1989fa;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  text-align: center;
}
