<!--pages/settings/index.wxml-->
<view class="settings-page">
  <view class="section">
    <view class="section-title">主题</view>
    <view class="theme-row">
      <view
        wx:for="{{themeOptions}}"
        wx:key="value"
        class="theme-card {{theme === item.value ? 'selected' : ''}}"
        data-value="{{item.value}}"
        bindtap="selectTheme"
      >
        <view class="theme-card-name">{{item.name}}</view>
        <view class="theme-card-desc">{{item.desc}}</view>
        <view class="theme-card-check" wx:if="{{theme === item.value}}">✓</view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">自定义背景</view>
    <view class="theme-hint" wx:if="{{!hasCustomBg}}">
      当前使用主题默认背景，上传图片后将覆盖
    </view>
    <view class="preview-box" wx:if="{{bgImage}}">
      <image class="preview-img" src="{{bgImage}}" mode="aspectFill" style="opacity: {{bgOpacity}};" />
      <view class="preview-label">{{hasCustomBg ? '自定义背景' : '主题默认背景'}}</view>
    </view>
    <button class="setting-btn" bindtap="chooseImage">{{bgImage && hasCustomBg ? '更换背景图片' : '选择背景图片'}}</button>
    <view class="slider-group" wx:if="{{bgImage && hasCustomBg}}">
      <view class="slider-label">背景透明度: {{sliderValue}}%</view>
      <slider min="5" max="100" value="{{sliderValue}}" bindchange="onOpacityChange" activeColor="#1989fa" block-size="20" />
    </view>
    <button class="setting-btn clear-btn" wx:if="{{hasCustomBg}}" bindtap="clearBackground">清除自定义背景</button>
  </view>

  <view class="section">
    <view class="section-title">字体颜色</view>
    <view class="color-row">
      <view
        wx:for="{{fontPresets}}"
        wx:key="index"
        wx:for-item="item"
        class="color-swatch {{fontColor === item[0] ? 'selected' : ''}}"
        style="background-color: {{item[0]}};"
        data-color="{{item[0]}}"
        bindtap="selectFontColor"
      ></view>
    </view>
    <view class="color-name">{{fontPresets[0] ? '' : ''}}</view>
  </view>

  <view class="section">
    <view class="section-title">框线颜色</view>
    <view class="color-row">
      <view
        wx:for="{{borderPresets}}"
        wx:key="index"
        wx:for-item="item"
        class="color-swatch {{borderColor === item[0] ? 'selected' : ''}}"
        style="background-color: {{item[0]}}; border: 2rpx solid #ddd;"
        data-color="{{item[0]}}"
        bindtap="selectBorderColor"
      ></view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">上课提醒</view>
    <view class="theme-hint">把本学期课程写进手机日历，上课前按下面的提前量响铃，不依赖网络。</view>
    <view class="remind-row">
      <text class="remind-label">提前提醒</text>
      <view class="remind-input-wrap">
        <input class="remind-input" type="number" value="{{remindMinutes}}" bindinput="onRemindInput" bindblur="onRemindBlur" />
        <text class="remind-unit">分钟前</text>
      </view>
    </view>
    <view class="remind-presets">
      <view class="preset-chip" wx:for="{{remindOptions}}" wx:key="*this" data-minutes="{{item}}" bindtap="useRemindPreset">{{item}}</view>
    </view>
    <view class="theme-hint">可填 {{remindMin}}~{{remindMax}} 分钟，上课前按这个时间提醒。</view>
    <button class="setting-btn" bindtap="syncToCalendar" disabled="{{syncing}}">同步到手机日历</button>
    <view class="theme-hint">连续周次会生成“每周重复”事件；单周课拆成每次一条。改动课表后建议重新同步。</view>
  </view>

  <view class="section">
    <view class="section-title">微信服务通知</view>
    <view class="theme-hint">到点前会收到一条微信服务通知。微信规则是「一次授权一条」：点一次订阅记 1 次；首次授权时可勾选「总是保持以上选择」，之后每点一次直接记 1 次、不再弹窗，多点几次就能攒着。</view>
    <view class="remind-status">{{reminderStatusLoading ? '读取中…' : reminderStatusText}}</view>
    <view class="remind-warn" wx:if="{{reminderWarnText}}">{{reminderWarnText}}</view>
    <button class="setting-btn" bindtap="subscribeReminder">订阅一次提醒</button>
    <button class="setting-btn ghost-btn" bindtap="refreshReminderSchedule">改完课表后刷新排期</button>
  </view>

  <view class="section">
    <view class="section-title">账户</view>
    <button class="setting-btn" bindtap="goProfile">我的</button>
  </view>
</view>
