/* pages/settings/index.wxss */

.settings-page {
  padding: 30rpx;
  min-height: 100vh;
  background: #f5f5f5;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  color: #333;
}

.preview-box {
  position: relative;
  height: 300rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  background: #eee;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.preview-label {
  position: absolute;
  bottom: 16rpx;
  left: 16rpx;
  background: rgba(0,0,0,0.5);
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.setting-btn {
  background: #1989fa;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  border: none;
  margin-bottom: 16rpx;
}

.setting-btn.clear-btn {
  background: #f5f5f5;
  color: #e74c3c;
}

.slider-group {
  padding: 16rpx 0;
  margin-bottom: 8rpx;
}

.slider-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.color-row {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}

.color-swatch {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 4rpx solid transparent;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
}

.color-swatch.selected {
  border-color: #1989fa;
  transform: scale(1.15);
}

/* 主题卡片 */
.theme-row {
  display: flex;
  gap: 20rpx;
}

.theme-card {
  flex: 1;
  position: relative;
  padding: 24rpx 20rpx;
  border-radius: 12rpx;
  background: #f8f8f8;
  border: 4rpx solid transparent;
  transition: all 0.2s;
}

.theme-card.selected {
  border-color: #1989fa;
  background: rgba(25, 137, 250, 0.08);
}

.theme-card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
}

.theme-card-desc {
  font-size: 22rpx;
  color: #888;
}

.theme-card-check {
  position: absolute;
  top: 10rpx;
  right: 14rpx;
  width: 36rpx;
  height: 36rpx;
  background: #1989fa;
  color: #fff;
  border-radius: 50%;
  font-size: 24rpx;
  line-height: 36rpx;
  text-align: center;
}

.theme-hint {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
  padding: 12rpx 16rpx;
  background: #f8f8f8;
  border-radius: 8rpx;
}
