/* pages/changelog/index.wxss */

.bg-layer {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  pointer-events: none;
}

.bg-image {
  width: 100%;
  height: 100%;
}

.changelog-page {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

.page-head {
  padding: 8rpx 4rpx 28rpx;
}

.head-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #111827;
}

.head-sub {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

.version-card {
  margin-bottom: 28rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 4rpx 16rpx rgba(17, 24, 39, 0.05);
}

.version-head {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.version-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
}

.version-tag {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: #eef4ff;
  font-size: 18rpx;
  color: #1989fa;
}

.version-date {
  margin-left: auto;
  font-size: 22rpx;
  color: #9ca3af;
}

.update-item {
  display: flex;
  align-items: flex-start;
  margin-top: 18rpx;
}

.type-tag {
  flex-shrink: 0;
  margin-right: 14rpx;
  margin-top: 2rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-size: 18rpx;
  line-height: 1.6;
}

.type-tag.new {
  background: #e8f2ff;
  color: #1989fa;
}

.type-tag.improve {
  background: #e6f7f0;
  color: #059669;
}

.type-tag.remove {
  background: #f3f4f6;
  color: #6b7280;
}

.item-text {
  flex: 1;
  font-size: 25rpx;
  line-height: 1.6;
  color: #374151;
}

.page-foot {
  margin-top: 30rpx;
  text-align: center;
  font-size: 20rpx;
  color: #b0b6bf;
}
