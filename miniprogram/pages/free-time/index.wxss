/* pages/free-time/index.wxss */

.bg-layer {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  pointer-events: none;
}

.bg-image {
  width: 100%;
  height: 100%;
}

.free-page {
  position: relative;
  z-index: 1;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 顶部 */
.page-head {
  padding: 20rpx 30rpx 12rpx;
  background: rgba(255, 255, 255, 0.75);
}

.head-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.head-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #888;
}

.tabs {
  display: flex;
  margin-top: 16rpx;
  padding: 4rpx;
  border-radius: 12rpx;
  background: rgba(0, 0, 0, 0.05);
}

.tab {
  flex: 1;
  padding: 10rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #666;
  border-radius: 10rpx;
}

.tab.on {
  background: #fff;
  color: #1989fa;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

/* 内容区 */
.body {
  flex: 1;
  min-height: 0;
  padding: 20rpx 24rpx 40rpx;
  box-sizing: border-box;
}

.loading,
.empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}

.error-box {
  padding: 100rpx 40rpx;
  text-align: center;
}

.error-text {
  margin-bottom: 30rpx;
  font-size: 28rpx;
  color: #666;
}

.error-btn {
  width: 320rpx;
  margin: 0 auto;
  background: #1989fa;
  color: #fff;
  font-size: 28rpx;
  border-radius: 12rpx;
}

/* 摘要卡 */
.summary-card {
  padding: 28rpx 30rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.summary-free {
  font-size: 36rpx;
  font-weight: 600;
  color: #1989fa;
}

.summary-next {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #555;
}

.summary-count {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #999;
}

.section-title {
  margin: 30rpx 0 12rpx;
  font-size: 24rpx;
  color: #888;
}

/* 窗口卡片 */
.window-item {
  margin-bottom: 16rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  border-left: 8rpx solid #1989fa;
  background: rgba(255, 255, 255, 0.9);
}

.window-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.window-time {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.window-tag {
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  border: 1rpx solid #1989fa;
  border-radius: 20rpx;
}

.window-advice {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.window-note {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #aaa;
}

/* 碎片 */
.fragment-bar {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 18rpx 24rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
  color: #666;
}

.fragment-toggle {
  color: #1989fa;
}

.fragment-list {
  margin-top: 12rpx;
}

.fragment-item {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
  padding: 14rpx 24rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.6);
  font-size: 24rpx;
  color: #666;
}

.fragment-desc {
  color: #999;
}

/* 饭点 */
.meal-list {
  padding: 8rpx 0;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.6);
}

.meal-item {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 24rpx;
  font-size: 24rpx;
  color: #aaa;
}

.meal-desc {
  color: #bbb;
}

/* 本周 */
.week-list {
  margin-top: 16rpx;
}

.week-row {
  margin-bottom: 14rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.85);
}

.week-row.today {
  border: 2rpx solid rgba(25, 137, 250, 0.5);
}

.week-head {
  display: flex;
  align-items: center;
}

.week-day {
  width: 90rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.week-date {
  flex: 1;
  font-size: 22rpx;
  color: #999;
}

.week-total {
  font-size: 24rpx;
  color: #1989fa;
}

.week-windows {
  display: flex;
  flex-wrap: wrap;
  margin-top: 10rpx;
}

.week-window {
  margin-right: 16rpx;
  font-size: 22rpx;
}

.week-empty {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #bbb;
}

.week-tip {
  margin-top: 24rpx;
  text-align: center;
  font-size: 20rpx;
  color: #aaa;
}
