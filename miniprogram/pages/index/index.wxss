/* pages/index/index.wxss */

.timetable-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  position: relative;
  z-index: 1;
}

/* 顶部 */
.header {
  background: rgba(255,255,255,0.75);
  padding: 10rpx 30rpx;
  color: #333;
}

.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.settings-btn {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border: 2rpx solid #ccc;
  border-radius: 20rpx;
}

.timetable-title {
  font-size: 26rpx;
  opacity: 0.85;
  margin-bottom: 6rpx;
  display: flex;
  align-items: center;
}

.title-arrow {
  margin-left: 8rpx;
  font-size: 22rpx;
}

.week-switcher {
  display: flex;
  align-items: center;
  justify-content: center;
}

.week-label {
  font-size: 36rpx;
  font-weight: 600;
  margin: 0 40rpx;
}

.week-arrow {
  font-size: 32rpx;
  padding: 10rpx 20rpx;
}

.week-arrow.disabled {
  opacity: 0.3;
}

/* 全局背景 */
.bg-layer {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  pointer-events: none;
}

.bg-image {
  width: 100%;
  height: 100%;
}

/* 表格容器 */
.table-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.table-header {
  display: flex;
  background: rgba(255,255,255,0.5);
  flex-shrink: 0;
}

.time-header {
  width: 100rpx;
  font-size: 22rpx;
  text-align: center;
  padding: 16rpx 0;
  flex-shrink: 0;
}

.day-header {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
}

.day-name {
  font-size: 26rpx;
  font-weight: 500;
}

.day-date {
  font-size: 20rpx;
  margin-top: 4rpx;
}

/* 表格体 */
.table-body {
  flex: 1;
  background: rgba(255,255,255,0.4);
}

.table-row {
  display: flex;
  min-height: 100rpx;
}

.time-cell {
  width: 100rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.2);
}

.slot-num {
  font-size: 22rpx;
}

.slot-time {
  font-size: 16rpx;
  margin-top: 2rpx;
}

.day-cell {
  flex: 1;
  position: relative;
}

/* 课程卡片 */
.course-card {
  margin: 2rpx;
  border-radius: 8rpx;
  padding: 6rpx 8rpx;
  overflow: hidden;
  box-sizing: border-box;
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  z-index: 2;
  opacity: 0.78;
}

.course-name {
  font-size: 22rpx;
  font-weight: 500;
  color: #fff;
  line-height: 1.3;
}

.course-info {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.3;
}

/* 空白格子 */
.empty-slot {
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-plus {
  font-size: 36rpx;
  font-weight: 300;
}

/* 悬浮添加按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #1989fa;
  box-shadow: 0 6rpx 20rpx rgba(25, 137, 250, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 50;
}

.fab-icon {
  font-size: 56rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
}

/* 详情弹窗 */
.detail-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
}

.detail-popup {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255,255,255,0.92);
  border-radius: 24rpx 24rpx 0 0;
  z-index: 101;
  padding: 40rpx;
  transform: translateY(100%);
  transition: transform 0.3s;
}

.detail-popup.show {
  transform: translateY(0);
}

.detail-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.detail-color {
  width: 16rpx;
  height: 40rpx;
  border-radius: 6rpx;
  margin-right: 16rpx;
}

.detail-name {
  font-size: 36rpx;
  font-weight: 600;
}

.detail-info {
  margin-bottom: 40rpx;
}

.detail-row {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
  font-size: 28rpx;
  color: #333;
}

.detail-label {
  color: #888;
  width: 120rpx;
  flex-shrink: 0;
}

.detail-slots {
  flex: 1;
}

.detail-slot-line {
  padding: 4rpx 0;
  font-size: 28rpx;
  color: #333;
}

.detail-actions {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.btn-edit,
.btn-delete {
  flex: 1;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  text-align: center;
  border: none;
}

.btn-edit {
  background: #1989fa;
  color: #fff;
}

.btn-delete {
  background: #f5f5f5;
  color: #e74c3c;
}

.detail-close {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 16rpx;
}

/* 字体颜色 */
.fc-333333, .fc-333333 view, .fc-333333 text { color: #333333; }
.fc-1a1a2e, .fc-1a1a2e view, .fc-1a1a2e text { color: #1a1a2e; }
.fc-16213e, .fc-16213e view, .fc-16213e text { color: #16213e; }
.fc-2d3436, .fc-2d3436 view, .fc-2d3436 text { color: #2d3436; }
.fc-ffffff, .fc-ffffff view, .fc-ffffff text { color: #ffffff; }

/* 框线颜色 */
.bc-e0e0e0 .table-header,
.bc-e0e0e0 .table-row,
.bc-e0e0e0 .time-cell,
.bc-e0e0e0 .day-cell,
.bc-e0e0e0 .day-header { border-color: #e0e0e0; }
.bc-e0e0e0 .table-header { border-bottom: 2rpx solid #e0e0e0; }
.bc-e0e0e0 .table-row { border-bottom: 2rpx solid #e0e0e0; }
.bc-e0e0e0 .time-cell { border-right: 2rpx solid #e0e0e0; }
.bc-e0e0e0 .day-cell,
.bc-e0e0e0 .day-header { border-left: 2rpx solid #e0e0e0; }

.bc-cccccc .table-header { border-bottom: 2rpx solid #cccccc; }
.bc-cccccc .table-row { border-bottom: 2rpx solid #cccccc; }
.bc-cccccc .time-cell { border-right: 2rpx solid #cccccc; }
.bc-cccccc .day-cell,
.bc-cccccc .day-header { border-left: 2rpx solid #cccccc; }

.bc-b0b0b0 .table-header { border-bottom: 2rpx solid #b0b0b0; }
.bc-b0b0b0 .table-row { border-bottom: 2rpx solid #b0b0b0; }
.bc-b0b0b0 .time-cell { border-right: 2rpx solid #b0b0b0; }
.bc-b0b0b0 .day-cell,
.bc-b0b0b0 .day-header { border-left: 2rpx solid #b0b0b0; }

/* 新建课表提示横幅 */
.create-tip {
  position: fixed;
  top: 20rpx;
  left: 30rpx;
  right: 30rpx;
  background: linear-gradient(135deg, #1989fa, #4A90D9);
  color: #fff;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  display: flex;
  align-items: center;
  z-index: 50;
  box-shadow: 0 6rpx 20rpx rgba(25, 137, 250, 0.3);
}

.create-tip-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.create-tip-text {
  flex: 1;
}

.create-tip-title {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.create-tip-desc {
  font-size: 24rpx;
  opacity: 0.85;
}

.create-tip-arrow {
  font-size: 44rpx;
  font-weight: 300;
  opacity: 0.8;
  line-height: 1;
}

/* ===== 今天指示 ===== */

/* 本周徽标（只在浏览真实周次时出现） */
.week-label .week-badge {
  margin-left: 10rpx;
  padding: 0 8rpx;
  font-size: 18rpx;
  font-weight: 400;
  color: #1989fa;
  border: 1rpx solid #1989fa;
  border-radius: 8rpx;
}

/* 今天条 */
.timetable-page .today-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
  padding: 4rpx 2rpx 0;
  font-size: 22rpx;
  color: #666;
}

.today-strip .today-info {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.today-strip .today-weekday {
  color: #1989fa;
  font-weight: 600;
}

.today-strip .today-date {
  margin-left: 10rpx;
  color: #666;
}

.today-strip .today-free {
  margin-left: 10rpx;
  color: #39b54a;
}

.today-strip .today-note {
  margin-left: 10rpx;
  color: #999;
}

.today-strip .today-jump {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.today-strip .today-back {
  padding: 2rpx 14rpx;
  font-size: 20rpx;
  color: #1989fa;
  border: 1rpx solid #1989fa;
  border-radius: 20rpx;
}

.today-strip .today-arrow {
  margin-left: 10rpx;
  font-size: 26rpx;
  color: #999;
}

/* 今天所在的列 */
.day-header.today .day-name {
  color: #1989fa;
  font-weight: 600;
}

.day-header.today .day-date {
  color: #1989fa;
}

.today-mark {
  width: 32rpx;
  height: 4rpx;
  margin: 6rpx auto 0;
  border-radius: 2rpx;
  background: #1989fa;
  opacity: 0;
}

.today-mark.on {
  opacity: 1;
}
